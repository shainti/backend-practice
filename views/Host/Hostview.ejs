<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>View Student</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f6f8;
      margin: 0;
      padding: 0;
    }

    .page {
      padding: 40px;
    }

    .card {
      max-width: 560px;
      margin: 20px auto;
      background: #ffffff;
      padding: 24px;
      border-radius: 10px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.12);
    }

    .card h2 {
      text-align: center;
      margin-bottom: 22px;
      color: #4e54c8;
      border-bottom: 1px solid #e6e6e6;
      padding-bottom: 10px;
    }

    .content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
    }

    .details {
      flex: 1;
    }

    .detail {
      margin-bottom: 14px;
      font-size: 15px;
      color: #333;
    }

    .detail span {
      font-weight: bold;
      color: #000;
      display: inline-block;
      min-width: 100px;
    }

    .photo img {
      width: 130px;
      height: 130px;
      object-fit: cover;
      border-radius: 8px;
      border: 1px solid #ddd;
      background-color: #fafafa;
    }

    .actions {
      margin-top: 20px;
      display: flex;
      justify-content: flex-end;
      gap: 12px;
    }

    .btn {
      color: #4e54c8;
      padding: 8px 16px;
      text-decoration: none;
      border: 1px solid #4e54c8;
      border-radius: 6px;
      background: transparent;
      cursor: pointer;
      font-size: 14px;
    }

    .btn:hover {
      background-color: #4e54c8;
      color: #fff;
    }

    @media (max-width: 600px) {
      .content {
        flex-direction: column-reverse;
        text-align: center;
      }

      .actions {
        justify-content: center;
      }

      .detail span {
        min-width: auto;
      }
    }
  </style>
</head>

<body>

  <!-- Navbar -->
  <%- include('../partials/nav') %>

  <div class="page">
    <% studentdetails.forEach(s => { %>
      <div class="card">
        <h2>Student Details</h2>

        <div class="content">
          <div class="details">
            <div class="detail">
              <span>Full Name:</span> <%= s.FullName %>
            </div>

            <div class="detail">
              <span>Email:</span> <%= s.Email %>
            </div>

            <div class="detail">
              <span>Password:</span> <%= s.Password %>
            </div>
          </div>

          <div class="photo">
            <img src="/<%= s.photo %>" alt="Student Photo">
          </div>
        </div>

        <div class="actions">
          <a href="/HostviewStudent/<%= s._id %>" class="btn">Edit</a>

          <form action="/Deletestudent/<%= s._id %>" method="post">
            <button type="submit" class="btn">Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>

</body>
</html>
