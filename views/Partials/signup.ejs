<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sign Up</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f6f8;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .signup-container {
      background: #fff;
      padding: 25px;
      width: 330px;
      border-radius: 8px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .signup-container h2 {
      text-align: center;
      margin-bottom: 20px;
      color: #333;
    }

    label {
      font-size: 14px;
      color: #555;
      display: block;
      margin-bottom: 6px;
    }

    input[type="text"],
    input[type="email"],
    input[type="password"] {
      width: 100%;
      padding: 10px;
      margin-bottom: 15px;
      border: 1px solid #ccc;
      border-radius: 5px;
      font-size: 14px;
    }

    .role-box {
      display: flex;
      justify-content: space-around;
      margin-bottom: 15px;
    }

    .role-box label {
      display: flex;
      align-items: center;
      font-size: 14px;
      cursor: pointer;
    }

    .role-box input {
      margin-right: 6px;
    }

    button {
      width: 100%;
      padding: 10px;
      background-color: #4a90e2;
      border: none;
      color: white;
      font-size: 15px;
      border-radius: 5px;
      cursor: pointer;
    }

    button:hover {
      background-color: #357bd8;
    }

    p {
      text-align: center;
      margin-top: 15px;
      font-size: 13px;
    }

    a {
      color: #4a90e2;
      text-decoration: none;
    }
  </style>
</head>
<body>

  <div class="signup-container">
     <div>
        <% if(error.length > 0) { %>
            <div>
                <ul>
                    <% error.forEach(error => { %>
                        <li><%= error %></li>
                   <% }) %>
                </ul>
            </div>
        <% } %>
    </div>
    <h2>Create Account</h2>

    <form action="/signup" method="post">
      <label>Full Name</label>
      <input type="text" name="Name" value="<%= oldInput.Name ? oldInput.Name : '' %>" required>

      <label>Email</label>
      <input type="email" name="email" value="<%= oldInput.email ? oldInput.email : '' %>" required>

      <label>Password</label>
      <input type="password" name="password" required>

      <label>Confirm Password</label>
      <input type="password" name="confirmpassword" required>
      <button type="submit">Sign Up</button>
    </form>

    <p>Already have an account?
      <a href="/login">Login</a>
    </p>
  </div>
</body>
</html>
