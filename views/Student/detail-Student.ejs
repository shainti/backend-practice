<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Details</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f6f8;
      margin: 0;
      padding: 0;
    }

    .page {
      padding: 40px;
    }

    h1 {
      text-align: center;
      margin-bottom: 30px;
      color: #333;
    }

    .card {
      max-width: 600px;
      margin: auto;
      background: #ffffff;
      padding: 26px;
      border-radius: 12px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.12);
    }

    .card h2 {
      text-align: center;
      margin-bottom: 25px;
      color: #4e54c8;
      border-bottom: 1px solid #e5e5e5;
      padding-bottom: 10px;
    }

    .row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 30px;
    }

    .info {
      flex: 1;
    }

    .detail {
      margin-bottom: 14px;
      font-size: 16px;
      color: #333;
    }

    .detail span {
      font-weight: bold;
      color: #000;
      display: inline-block;
      min-width: 100px;
    }

    .photo img {
      width: 140px;
      height: 140px;
      object-fit: cover;
      border-radius: 10px;
      border: 1px solid #ddd;
      background-color: #fafafa;
    }

    .rules {
      margin-top: 25px;
      text-align: center;
    }

    .rules a {
      text-decoration: none;
      color: #ffffff;
      background-color: #4e54c8;
      padding: 12px 20px;
      border-radius: 6px;
      font-size: 15px;
      display: inline-block;
    }

    .rules a:hover {
      background-color: #3d42a3;
    }

    @media (max-width: 768px) {
      .row {
        flex-direction: column-reverse;
        text-align: center;
      }

      .detail span {
        min-width: auto;
      }
    }
  </style>
</head>

<body>

  <!-- Navbar -->
  <%- include('../partials/nav') %>

  <div class="page">
    <h1>Here are the details of your student</h1>

    <div class="card">
      <h2>Student Details</h2>

      <div class="row">
        <div class="info">
          <div class="detail">
            <span>Full Name:</span> <%= Onestudent.FullName %>
          </div>

          <div class="detail">
            <span>Email:</span> <%= Onestudent.Email %>
          </div>

          <div class="detail">
            <span>Password:</span> <%= Onestudent.Password %>
          </div>
        </div>

        <div class="photo">
          <img src="/<%= Onestudent.photo %>" alt="student photo">
        </div>
      </div>

      <div class="rules">
        <a href="/rules/<%= Onestudent.id %>">Download Student Rules</a>
      </div>
    </div>
  </div>

</body>
</html>
