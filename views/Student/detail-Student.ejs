<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>here are the details of your student</h1>
    <div class="card">
      <h2>Student Details</h2>

      <div class="detail">
        <span>Full Name:</span> <%= Onestudent.FullName %>
      </div>

      <div class="detail">
        <span>Email:</span> <%= Onestudent.Email %>
      </div>

      <div class="detail">
        <span>Password:</span> <%= Onestudent.Password %>
      </div>
       <div class="detail">
        <img src="<%= Onestudent.photo %>" alt="">
      </div>
    </div>
</body>
</html>