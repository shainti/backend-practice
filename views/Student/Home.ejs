<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Cheque</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background-color: #f4f6f8;
    }

    nav {
      background: linear-gradient(90deg, #4e54c8, #8f94fb);
      padding: 14px 30px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      color: #ffffff;
      font-size: 22px;
      font-weight: bold;
    }

    ul {
      list-style: none;
      display: flex;
      gap: 25px;
    }

    ul li a {
      text-decoration: none;
      color: #ffffff;
      font-size: 16px;
      padding: 6px 12px;
      border-radius: 4px;
      transition: background 0.3s ease;
    }

    ul li a:hover {
      background: rgba(255, 255, 255, 0.2);
    }
    .student{
        display: flex;
        justify-content: center;
        font-size: 4rem;
        align-content: center;
    }
  </style>
</head>

<body>
  <nav>
    <div class="logo">Student Cheque</div>
    <ul>
      <li><a href="/">Home</a></li>
      <% if (islogedIn) { %>
      <li><a href="/Addstudent">Add Student</a></li>
      <li><a href="/Viewstudent">View Students</a></li>
      <li><a href="/Hostview">HostView</a></li>
      <% } %>
      <% if (!islogedIn) { %>
        <li><a href="/Login">Login</a></li>
        <li><a href="/Signup">Signup</a></li>
      <% } else { %>
        <form action="/logout" method="POST">
  <button type="submit" style="
    padding: 10px 20px;
    background-color: #3cc5e7;
    color: rgb(85, 85, 85);
    border: none;
    border-radius: 5px;
    cursor: pointer;
  ">
    Logout
  </button>
</form>
      <% }%>
    </ul>
  </nav>
  <h1 class="student"> Welcome Students </h1>
</body>
</html>
